# PoSA Environment Configuration
# Copy this file to .env and replace placeholder values with your keys.
#
#   cp .env.example .env
#
# Never commit .env — it is gitignored.

# --- Backend API ---
BACKEND_PORT=8080

# --- AI Engine (Impulse AI) ---
# Impulse Labs API: https://docs.impulselabs.ai/
# Auth: x-api-key header
# Endpoint: https://api.impulselabs.ai/api/chat (SSE streaming)
AI_ENGINE_URL=https://api.impulselabs.ai
AI_API_KEY=

# --- GitHub API (Repo Analysis) ---
# Optional: increases rate limit from 60 to 5000 requests/hour.
# Generate at: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# --- GitHub OAuth (Authentication) ---
# Create at: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:8080/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Session Security ---
# HMAC secret for signing session tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If empty, tokens are unsigned (acceptable for development only).
SESSION_SECRET=

# --- IPFS (Local Development) ---
IPFS_API_URL=http://localhost:5001

# --- Infura IPFS (Managed IPFS Node) ---
# Infura docs: https://docs.infura.io/api/networks/ipfs
# Enable IPFS add-on in your Infura dashboard.
# Auth: Basic Auth with project ID as username, API secret as password.
# Upload: POST https://ipfs.infura.io:5001/api/v0/add
# Gateway: https://{project_id}.ipfs.infura-ipfs.io/ipfs/{cid}
INFURA_PROJECT_ID=
INFURA_API_SECRET=

# --- Lighthouse.storage (Primary Filecoin/IPFS Storage) ---
# Lighthouse docs: https://docs.lighthouse.storage/
# Stable pinning service with active Filecoin storage providers.
# Upload: POST https://upload.lighthouse.storage/api/v0/add (Bearer auth)
# Retrieve: GET https://gateway.lighthouse.storage/ipfs/{cid}
LIGHTHOUSE_API_KEY=

# --- Filecoin via Beryx (Zondax) — Chain Queries ---
# Beryx docs: https://docs.zondax.ch/beryx
# Provides authenticated Filecoin JSON-RPC proxy and data API.
#
# RPC endpoints:
#   Mainnet:     https://api.zondax.ch/fil/node/mainnet/rpc/v1
#   Calibration: https://api.zondax.ch/fil/node/calibration/rpc/v1
# Data API:
#   Mainnet:     https://api.zondax.ch/fil/data/v4/mainnet
#   Calibration: https://api.zondax.ch/fil/data/v4/calibration
FILECOIN_RPC_URL=https://api.zondax.ch/fil/node/mainnet/rpc/v1
FILECOIN_DATA_URL=https://api.zondax.ch/fil/data/v4/mainnet
BERYX_API_TOKEN=

# --- Filecoin go-synapse (when storage providers are available) ---
# go-synapse SDK: https://github.com/data-preservation-programs/go-synapse
# Auto-detects network from RPC chain ID (314=Mainnet, 314159=Calibration).
# Contract addresses resolved automatically:
#   PDPVerifier (Mainnet):     0xBADd0B92C1c71d02E7d520f64c0876538fa2557F
#   PDPVerifier (Calibration): 0x85e366Cf9DD2c0aE37E963d9556F5f4718d6417C
#   SP Registry (Mainnet):     0xf55dDbf63F1b55c3F1D4FA7e339a68AB7b64A5eB
#   SP Registry (Calibration): 0x839e5c9988e4e9977d40708d0094103c0839Ac9D
FILECOIN_PROVIDER_URL=
FILECOIN_PRIVATE_KEY=

# --- Blockchain (Flow) ---
# Flow docs: https://developers.flow.com/
# Testnet access node: https://rest-testnet.onflow.org
# Mainnet access node: https://rest-mainnet.onflow.org
FLOW_ACCESS_NODE=https://rest-mainnet.onflow.org
FLOW_ACCOUNT_ADDRESS=
FLOW_PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Lit Protocol v1 Naga SDK (Report Encryption) ---
# Lit docs: https://developer.litprotocol.com/
# Network: naga (v1 Naga SDK)
LIT_NETWORK=naga
LIT_API_KEY=

# --- Frontend (Development) ---
# These are set at build time by Next.js. In development, point to local services.
# In production (.env.production), leave empty for same-origin nginx proxy.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000

# --- Database ---
# SQLite file path. Created automatically on first run.
DATABASE_URL=./data/posa.db
