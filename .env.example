# PoSA Environment Configuration
# Copy this file to .env and replace placeholder values with your keys.
#
#   cp .env.example .env
#
# Never commit .env — it is gitignored.

# --- Backend API ---
BACKEND_PORT=8080

# --- AI Engine ---
AI_ENGINE_URL=http://localhost:8000
AI_API_KEY=

# --- IPFS (Local Development) ---
IPFS_API_URL=http://localhost:5001

# --- Filecoin / web3.storage (Production Storage) ---
# When FILECOIN_TOKEN is set, the backend uses web3.storage
# instead of the local IPFS node.
FILECOIN_API_URL=https://api.web3.storage
FILECOIN_GATEWAY_URL=https://w3s.link
FILECOIN_TOKEN=

# --- Blockchain (Flow) ---
FLOW_ACCESS_NODE=https://rest-testnet.onflow.org
FLOW_ACCOUNT_ADDRESS=
FLOW_PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Lit Protocol v1 Naga SDK (Report Encryption) ---
LIT_NETWORK=naga
LIT_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000
