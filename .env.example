# PoSA Environment Configuration
# Copy this file to .env and replace placeholder values with your keys.
#
#   cp .env.example .env
#
# Never commit .env — it is gitignored.

# --- Backend API ---
BACKEND_PORT=8080

# --- AI Engine ---
AI_ENGINE_URL=http://localhost:8000
AI_API_KEY=

# --- IPFS (Local Development) ---
IPFS_API_URL=http://localhost:5001

# --- Filecoin / go-synapse (Production Storage) ---
# The backend uses go-synapse to store data on Filecoin.
# go-synapse auto-detects the network from the RPC chain ID:
#   Chain ID 314    = Filecoin Mainnet
#   Chain ID 314159 = Filecoin Calibration (testnet)
#
# Contract addresses are resolved automatically by go-synapse:
#   PDPVerifier (Mainnet):     0xBADd0B92C1c71d02E7d520f64c0876538fa2557F
#   PDPVerifier (Calibration): 0x85e366Cf9DD2c0aE37E963d9556F5f4718d6417C
#   SP Registry (Mainnet):     0xf55dDbf63F1b55c3F1D4FA7e339a68AB7b64A5eB
#   SP Registry (Calibration): 0x839e5c9988e4e9977d40708d0094103c0839Ac9D
#
# RPC endpoints (public, no auth needed):
#   Mainnet:     https://api.node.glif.io/rpc/v1
#   Calibration: https://api.calibration.node.glif.io/rpc/v1
#
# FILECOIN_PROVIDER_URL is the storage provider's API endpoint.
# Providers register on-chain via the SP Registry contract.
# Currently no public providers are registered on the Synapse protocol.
# For testing, run a local provider or use IPFS_API_URL instead.
FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
FILECOIN_PROVIDER_URL=
FILECOIN_PRIVATE_KEY=

# --- Blockchain (Flow) ---
FLOW_ACCESS_NODE=https://rest-testnet.onflow.org
FLOW_ACCOUNT_ADDRESS=
FLOW_PRIVATE_KEY=
CONTRACT_ADDRESS=

# --- Lit Protocol v1 Naga SDK (Report Encryption) ---
LIT_NETWORK=naga
LIT_API_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_AI_URL=http://localhost:8000
