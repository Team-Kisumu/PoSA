#!/usr/bin/env bash
# prepare-commit-msg: Validate builds compile before finalizing commit
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

ERRORS=0

# --- Go build check ---
if echo "$STAGED" | grep -q '\.go$' && [ -d "backend" ] && command -v go &>/dev/null; then
    echo -e "${YELLOW}Validating Go build...${NC}"
    (cd backend && go build -o /dev/null ./... 2>&1) || { echo -e "${RED}✗ Go build failed — fix before committing${NC}"; ERRORS=1; }
    [ $ERRORS -eq 0 ] && echo -e "${GREEN}✓ Go build OK${NC}"
fi

# --- Python syntax check ---
PY_FILES=$(echo "$STAGED" | grep '\.py$' || true)
if [ -n "$PY_FILES" ] && command -v python3 &>/dev/null; then
    echo -e "${YELLOW}Validating Python syntax...${NC}"
    for f in $PY_FILES; do
        [ -f "$f" ] || continue
        python3 -m py_compile "$f" || { echo -e "${RED}✗ Syntax error in $f${NC}"; ERRORS=1; }
    done
    [ $ERRORS -eq 0 ] && echo -e "${GREEN}✓ Python syntax OK${NC}"
fi

# --- Frontend build check (only if many frontend files changed) ---
JS_COUNT=$(echo "$STAGED" | grep -cE '\.(js|jsx|ts|tsx)$' || true)
if [ "$JS_COUNT" -gt 3 ] && [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
    echo -e "${YELLOW}Validating frontend build...${NC}"
    (cd frontend && npm run build --if-present 2>&1) || { echo -e "${RED}✗ Frontend build failed${NC}"; ERRORS=1; }
    [ $ERRORS -eq 0 ] && echo -e "${GREEN}✓ Frontend build OK${NC}"
fi

if [ $ERRORS -ne 0 ]; then
    echo -e "${RED}Commit blocked: build validation failed${NC}"
    exit 1
fi
