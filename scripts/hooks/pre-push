#!/usr/bin/env bash
# pre-push: Lint checks and build validation before push
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

# --- Go: vet + build check ---
if [ -d "backend" ] && command -v go &>/dev/null; then
    echo -e "${YELLOW}Checking Go code...${NC}"
    (cd backend && go vet ./...) || { echo -e "${RED}✗ go vet failed${NC}"; ERRORS=1; }
    (cd backend && go build -o /dev/null ./... 2>/dev/null) || { echo -e "${RED}✗ Go build failed${NC}"; ERRORS=1; }
    [ $ERRORS -eq 0 ] && echo -e "${GREEN}✓ Go checks passed${NC}"
fi

# --- Python: flake8 lint ---
if [ -d "ai" ] && command -v flake8 &>/dev/null; then
    echo -e "${YELLOW}Checking Python code...${NC}"
    (cd ai && flake8 . --max-line-length=120 --exclude=__pycache__,.venv) || { echo -e "${RED}✗ flake8 failed${NC}"; ERRORS=1; }
    [ $ERRORS -eq 0 ] && echo -e "${GREEN}✓ Python checks passed${NC}"
fi

# --- Frontend: lint ---
if [ -d "frontend" ] && [ -f "frontend/package.json" ]; then
    echo -e "${YELLOW}Checking frontend code...${NC}"
    (cd frontend && npm run lint --if-present 2>/dev/null) || { echo -e "${YELLOW}⚠ Frontend lint skipped (no lint script)${NC}"; }
fi

if [ $ERRORS -ne 0 ]; then
    echo -e "${RED}Push blocked: fix the errors above${NC}"
    exit 1
fi

echo -e "${GREEN}✓ All pre-push checks passed${NC}"
